    <!-- Delete everything: two confirmations -->
    <string name="settings_delete_first_title">Delete everything?</string>
    <string name="settings_delete_first_body">This deletes every giveaway, entry, draw and certificate on this phone, the app lock, and your Instagram sign-in. Videos you saved to the gallery stay.</string>
    <string name="settings_delete_continue">Continue</string>
    <string name="settings_delete_second_title">This can\'t be undone</string>
    <string name="settings_delete_second_body">Without a backup, nothing can be brought back. The app will start again from the beginning.</string>

    <!-- Backup export -->
    <string name="backup_title">Encrypted backup</string>
    <string name="backup_body">The backup holds every giveaway, its entries and draws, encrypted with a password you choose. Your Instagram sign-in isn\'t included.</string>
    <string name="backup_keep_password_title">Keep the password safe</string>
    <string name="backup_keep_password_body">Without it the backup can\'t be opened, and no one can recover it for you.</string>
    <string name="backup_password">Password</string>
    <string name="backup_password_again">Password again</string>
    <string name="backup_mismatch">The passwords don\'t match.</string>
    <string name="backup_strength_none">Use at least 8 characters</string>
    <string name="backup_strength_weak">Weak</string>
    <string name="backup_strength_fair">Fair</string>
    <string name="backup_strength_good">Good</string>
    <string name="backup_strength_strong">Strong</string>
